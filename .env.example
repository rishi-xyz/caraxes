# Copy to .env and fill in the values. Never commit .env.

# --- Model provider ---
# Name of the variable holding the API key (default: OPENROUTER_API_KEY)
CARAXES_API_KEY_ENV=OPENROUTER_API_KEY
# Left commented so copying this file doesn't set an empty-but-present key.
# OPENROUTER_API_KEY=your-key-here

# OpenAI-compatible endpoint (default: https://openrouter.ai/api/v1)
CARAXES_BASE_URL=https://openrouter.ai/api/v1

# Model id (default: nvidia/nemotron-3-ultra-550b-a55b:free)
CARAXES_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Per-request timeout in seconds (default: 60)
CARAXES_TIMEOUT_SECS=60

# --- Logging ---
# off | error | warn | info | debug | trace
# Unset or empty means off; logs go to stderr so stdout is just the answer.
CARAXES_LOG=off

# Finer-grained filter, used only when CARAXES_LOG is empty/unset.
# Examples:
# RUST_LOG=debug
# RUST_LOG=caraxes_internal::model::openai=trace
# RUST_LOG=caraxes=debug
